  <version>0.1.0</version>
  <date>2026-10-14</date>
  <maintainer>Eddy-dev0</maintainer>
  <author>Eddy-dev0</author>
  <license>LGPL-2.1-or-later</license>
  <url type="repository" branch="main">https://github.com/Eddy-dev0/FreeCAD-SmartSnap</url>
  <url type="bugtracker">https://github.com/Eddy-dev0/FreeCAD-SmartSnap/issues</url>
  <url type="readme">https://github.com/Eddy-dev0/FreeCAD-SmartSnap/blob/main/README.md</url>
  <pythonmin>3.10</pythonmin>
  <content>
    <workbench>
      <name>SmartSnap</name>
      <subdirectory>./</subdirectory>
      <classname>SmartSnapWorkbench</classname>
    </workbench>
  </content>
</package>
